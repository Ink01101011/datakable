{
  "name": "datakable-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build",
    "dev": "pnpm -r --parallel --filter \"./packages/*\" dev",
    "docs": "pnpm --filter @datakable/docs dev",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "check:pkg": "pnpm -r --filter \"./packages/*\" check:pkg && pnpm check:consumer",
    "check:catalog": "pnpm --filter @datakable/core check:catalog",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish",
    "check:consumer": "node scripts/check-consumer-types.mjs",
    "size": "node scripts/size.mjs",
    "check:size": "node scripts/size.mjs --check",
    "check:budgets": "pnpm check:size && vitest run --config vitest.budgets.config.ts"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.5.15",
    "@changesets/cli": "^3.0.3",
    "@size-limit/preset-small-lib": "14.2.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "fast-check": "4.10.2",
    "happy-dom": "^20.14.5",
    "publint": "^0.3.25",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "size-limit": "14.2.0",
    "tsup": "^8.5.1",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
