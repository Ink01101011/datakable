{
  "name": "@datakable/core",
  "version": "0.0.0",
  "description": "Headless, framework-agnostic core of DataKable — table state, sorting, filtering and types.",
  "license": "MIT",
  "author": "Supakit Kitjanabumrungsak",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OWNER/datakable.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/OWNER/datakable#readme",
  "bugs": "https://github.com/OWNER/datakable/issues",
  "keywords": [
    "react",
    "datatable",
    "table",
    "data-grid",
    "typescript",
    "type-safe",
    "headless"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc -p tsconfig.json",
    "check:pkg": "publint --strict && attw --pack . --profile node16"
  },
  "dependencies": {
    "ex-search": "1.1.1",
    "exsorted": "1.2.3",
    "kk-debounce": "1.0.7"
  }
}
