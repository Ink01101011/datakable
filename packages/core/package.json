{
  "name": "@datakable/core",
  "version": "2.0.0",
  "description": "Headless, framework-agnostic core of DataKable — table state, sorting, filtering and types.",
  "license": "MIT",
  "author": "Supakit Kitjanabumrungsak",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ink01101011/datakable.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/Ink01101011/datakable#readme",
  "bugs": "https://github.com/Ink01101011/datakable/issues",
  "keywords": [
    "react",
    "react-table",
    "datatable",
    "data-table",
    "data-grid",
    "datagrid",
    "table",
    "typescript",
    "type-safe",
    "headless",
    "headless-ui",
    "zero-config",
    "sorting",
    "filtering",
    "search",
    "pagination",
    "framework-agnostic",
    "vanilla-js",
    "table-state"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/messages/index.js",
    "./dist/messages/index.cjs",
    "./dist/diagnostics/process-guard.js",
    "./dist/diagnostics/process-guard.cjs"
  ],
  "engines": {
    "node": ">=18.18.0"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "column-filters": [
        "./dist/column-filters.d.ts"
      ],
      "validity": [
        "./dist/validity.d.ts"
      ],
      "search": [
        "./dist/search.d.ts"
      ],
      "sorting": [
        "./dist/sorting.d.ts"
      ],
      "pagination": [
        "./dist/pagination.d.ts"
      ],
      "messages": [
        "./dist/messages.d.ts"
      ],
      "schema": [
        "./dist/schema.d.ts"
      ],
      "search-async": [
        "./dist/search-async.d.ts"
      ],
      "server": [
        "./dist/server.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./column-filters": {
      "import": {
        "types": "./dist/column-filters.d.ts",
        "default": "./dist/features/column-filters/index.js"
      },
      "require": {
        "types": "./dist/column-filters.d.cts",
        "default": "./dist/features/column-filters/index.cjs"
      }
    },
    "./validity": {
      "import": {
        "types": "./dist/validity.d.ts",
        "default": "./dist/features/validity/index.js"
      },
      "require": {
        "types": "./dist/validity.d.cts",
        "default": "./dist/features/validity/index.cjs"
      }
    },
    "./search": {
      "import": {
        "types": "./dist/search.d.ts",
        "default": "./dist/features/search/index.js"
      },
      "require": {
        "types": "./dist/search.d.cts",
        "default": "./dist/features/search/index.cjs"
      }
    },
    "./sorting": {
      "import": {
        "types": "./dist/sorting.d.ts",
        "default": "./dist/features/sorting/index.js"
      },
      "require": {
        "types": "./dist/sorting.d.cts",
        "default": "./dist/features/sorting/index.cjs"
      }
    },
    "./pagination": {
      "import": {
        "types": "./dist/pagination.d.ts",
        "default": "./dist/features/pagination/index.js"
      },
      "require": {
        "types": "./dist/pagination.d.cts",
        "default": "./dist/features/pagination/index.cjs"
      }
    },
    "./messages": {
      "import": {
        "types": "./dist/messages.d.ts",
        "default": "./dist/messages/index.js"
      },
      "require": {
        "types": "./dist/messages.d.cts",
        "default": "./dist/messages/index.cjs"
      }
    },
    "./schema": {
      "import": {
        "types": "./dist/schema.d.ts",
        "default": "./dist/ingest/schema-entry.js"
      },
      "require": {
        "types": "./dist/schema.d.cts",
        "default": "./dist/ingest/schema-entry.cjs"
      }
    },
    "./search-async": {
      "import": {
        "types": "./dist/search-async.d.ts",
        "default": "./dist/features/search/search-async-entry.js"
      },
      "require": {
        "types": "./dist/search-async.d.cts",
        "default": "./dist/features/search/search-async-entry.cjs"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/server.d.ts",
        "default": "./dist/source/server-entry.js"
      },
      "require": {
        "types": "./dist/server.d.cts",
        "default": "./dist/source/server-entry.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && node scripts/postbuild.mjs",
    "dev": "tsup --watch",
    "typecheck": "tsc -p tsconfig.json",
    "check:pkg": "publint --strict && attw --pack . && node scripts/check-catalog.mjs",
    "check:catalog": "node scripts/check-catalog.mjs"
  },
  "dependencies": {
    "ex-search": "1.1.1",
    "exsorted": "1.2.3",
    "kk-debounce": "1.1.0"
  },
  "devDependencies": {
    "esbuild": "0.27.7"
  }
}
