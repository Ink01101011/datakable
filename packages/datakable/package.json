{
  "name": "datakable",
  "version": "1.0.1",
  "description": "Type-safe generic DataTable for React. Zero-config by default, headless when you need it.",
  "license": "MIT",
  "author": "Supakit Kitjanabumrungsak",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ink01101011/datakable.git",
    "directory": "packages/datakable"
  },
  "homepage": "https://github.com/Ink01101011/datakable#readme",
  "bugs": "https://github.com/Ink01101011/datakable/issues",
  "keywords": [
    "react",
    "datatable",
    "table",
    "data-grid",
    "typescript",
    "type-safe",
    "headless"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/messages.js",
    "./dist/messages.cjs",
    "./dist/styles.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/core.d.ts",
        "default": "./dist/core.js"
      },
      "require": {
        "types": "./dist/core.d.cts",
        "default": "./dist/core.cjs"
      }
    },
    "./messages": {
      "import": {
        "types": "./dist/messages.d.ts",
        "default": "./dist/messages.js"
      },
      "require": {
        "types": "./dist/messages.d.cts",
        "default": "./dist/messages.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc -p tsconfig.json",
    "check:pkg": "publint --strict && attw --pack . --profile node16 --exclude-entrypoints styles.css"
  },
  "dependencies": {
    "@datakable/core": "workspace:^",
    "@datakable/react": "workspace:^"
  },
  "peerDependencies": {
    "react": ">=18"
  }
}
