{
  "name": "@datakable/react",
  "version": "1.0.1",
  "description": "React bindings for DataKable — useDataTable hook and DataTable component.",
  "license": "MIT",
  "author": "Supakit Kitjanabumrungsak",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ink01101011/datakable.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/Ink01101011/datakable#readme",
  "bugs": "https://github.com/Ink01101011/datakable/issues",
  "keywords": [
    "react",
    "datatable",
    "table",
    "data-grid",
    "typescript",
    "type-safe",
    "headless"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/styles.css"
  ],
  "engines": {
    "node": ">=18.18.0"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": {
      "types": {
        "import": "./dist/styles.css.d.ts",
        "require": "./dist/styles.css.d.cts"
      },
      "default": "./dist/styles.css"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && node ../../scripts/write-styles-dts.mjs",
    "dev": "tsup --watch",
    "typecheck": "tsc -p tsconfig.json",
    "check:pkg": "publint --strict && attw --pack . --profile node16 && node scripts/check-catalog.mjs",
    "check:catalog": "node scripts/check-catalog.mjs"
  },
  "dependencies": {
    "@datakable/core": "workspace:^"
  },
  "peerDependencies": {
    "react": ">=18"
  }
}
