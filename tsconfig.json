{
  // Root project: editor + vitest typecheck. Maps workspace packages to source
  // so type tests don't need a build. Package builds use their own tsconfig.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "@datakable/core": ["./packages/core/src/index.ts"],
      "@datakable/core/messages": ["./packages/core/src/messages/index.ts"],
      "@datakable/core/*": ["./packages/core/src/features/*/index.ts"],
      "@datakable/react": ["./packages/react/src/index.ts"],
      "datakable": ["./packages/datakable/src/index.ts"],
      "datakable/*": ["./packages/datakable/src/*.ts"]
    }
  },
  "include": ["packages/*/src", "vitest.config.ts"]
}
